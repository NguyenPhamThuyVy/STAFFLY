<UserControl x:Class="StafflyApp.Views.HRDepartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:views="clr-namespace:StafflyApp.Views"
             Background="#F4F6F9" FontFamily="Segoe UI">

    <materialDesign:DialogHost IsOpen="{Binding IsImportDialogOpen}" Identifier="AttendanceDialog">
        <materialDesign:DialogHost.DialogContent>
            <views:AttendanceImportView DataContext="{Binding ImportVM}" />
        </materialDesign:DialogHost.DialogContent>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DEPARTMENT ANALYTICS &amp; ATTENDANCE AUDIT" FontSize="20" FontWeight="Bold" Foreground="#1A365D"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ComboBox SelectedValue="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" 
                                  materialDesign:HintAssist.Hint="Month" Width="120" Margin="0,0,10,0" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="55" 
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <system:Int32>1</system:Int32>
                            <system:Int32>2</system:Int32>
                            <system:Int32>3</system:Int32>
                            <system:Int32>4</system:Int32>
                            <system:Int32>5</system:Int32>
                            <system:Int32>6</system:Int32>
                            <system:Int32>7</system:Int32>
                            <system:Int32>8</system:Int32>
                            <system:Int32>9</system:Int32>
                            <system:Int32>10</system:Int32>
                            <system:Int32>11</system:Int32>
                            <system:Int32>12</system:Int32>
                        </ComboBox>
                        <ComboBox SelectedValue="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" 
                                  materialDesign:HintAssist.Hint="Year" Width="120" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="55" 
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <system:Int32>2024</system:Int32>
                            <system:Int32>2025</system:Int32>
                            <system:Int32>2026</system:Int32>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Command="{Binding OpenImportDialogCommand}"
                        Background="#10B981" Foreground="White" BorderThickness="0" 
                        Height="50" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="12" Margin="0,37,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="IMPORT ATTENDANCE" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" MinWidth="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="⚠️ Attendance Exceptions: Absence vs Tardy" FontSize="14" FontWeight="Bold" Foreground="#BE123C"/>
                            <TextBlock Text="{Binding PerformanceComparison}" FontSize="12" Foreground="{Binding ComparisonColor}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding AttendanceExceptionsSeries}" LegendLocation="Bottom" DisableAnimations="True">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Departments" Labels="{Binding DepartmentLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Count (Times)" MinValue="0">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="25,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Attendance Attention" FontSize="16" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TopRiskyList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#FDBA74" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountClockOutline" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,12,0" Width="22" Height="22"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#9A3412"/>
                                                <TextBlock Text="{Binding Count, StringFormat='Instances: {0}'}" FontSize="12" Foreground="#C2410C"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>