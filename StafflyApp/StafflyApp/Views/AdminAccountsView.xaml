<UserControl x:Class="StafflyApp.Views.AdminAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:StafflyApp.ViewModels"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.DataContext>
        <vm:AdminAccountsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="25" Padding="30" Margin="10,0,10,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Account Management" FontSize="26" FontWeight="Bold" Foreground="#1A1C29"/>
                    <TextBlock Text="Provision operational credentials, roles, and functional status tokens." Foreground="#6B7280" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Command="{Binding OpenCreateAccountPopupCommand}"
                        Background="#1954D1" Foreground="White" BorderThickness="0" Height="45" Padding="20,0"
                        materialDesign:ButtonAssist.CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="CREATE ACCOUNT" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding AccountsList}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0" Background="White" RowHeight="50"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="User ID" Binding="{Binding UserID}" Width="85" IsReadOnly="True" Foreground="#6B7280"/>

                    <DataGridTemplateColumn Header="Username" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Foreground="#1A1C29" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="#EF4444" Margin="6,0,0,0" 
                                                             VerticalAlignment="Center" ToolTip="Password Reset Requested!"
                                                             Visibility="{Binding IsResetRequested, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="190" Foreground="#374151"/>

                    <DataGridTemplateColumn Header="Assigned Role" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RoleName}" 
                                           FontWeight="Medium" 
                                           Foreground="#4B5563"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left" 
                                           Margin="10,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Status (IsActive)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ToggleAccountStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                        ToolTip="Reset to Default Password"
                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Height="32" Width="32" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="LockReset" Foreground="#D97706"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <Popup IsOpen="{Binding IsCreateAccountPopupOpen}" Placement="Center" 
                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" AllowsTransparency="True" StaysOpen="False">
                <Border Background="White" Width="380" CornerRadius="16" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="#000" Opacity="0.1" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔐 New Credentials Provision" FontSize="18" FontWeight="Bold" Foreground="#1954D1" Margin="0,0,0,20"/>

                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsEditMode}"
                                 materialDesign:HintAssist.Hint="Username" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>
                        
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Email Address" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>
                        
                        <PasswordBox x:Name="NewPasswordBox" 
                                     materialDesign:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding RolesCollection}" SelectedItem="{Binding SelectedRole}" 
                                  materialDesign:HintAssist.Hint="Select System Role" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,25"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancel" Command="{Binding ClosePopupCommand}" Background="#E5E7EB" Foreground="#374151" BorderThickness="0" Height="40" Margin="0,0,5,0" materialDesign:ButtonAssist.CornerRadius="8"/>

                            <Button Grid.Column="1" Content="Confirm Account" 
                                    Command="{Binding CreateAccountCommand}" 
                                    CommandParameter="{Binding ElementName=NewPasswordBox}"
                                    Background="#1954D1" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="40" Margin="5,0,0,0" materialDesign:ButtonAssist.CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>