<UserControl x:Class="StafflyApp.Views.PayrollApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:StafflyApp.ViewModels"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1100" Background="#F4F6F9" FontFamily="Segoe UI">

    <UserControl.DataContext>
        <vm:PayrollApprovalViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="PAYROLL APPROVAL PIPELINE" FontSize="24" FontWeight="Bold" Foreground="#1A1C29"/>
                <TextBlock Text="Review targeted timeline submissions from HR Staff and execute structural approvals." Foreground="#6B7280" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ApprovePayrollSheetCommand}"
                        Background="#10B981" Foreground="White" BorderThickness="0" Height="42" Padding="15,0" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="APPROVE" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenRejectPopupCommand}"
                        Background="#EF4444" Foreground="White" BorderThickness="0" Height="42" Padding="15,0" materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="REJECT" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,15" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingAlert}" Value="True">
                            <Setter Property="Background" Value="#FFFBEB"/>
                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="BellRing" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,10,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="#4B5563"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>

                <TextBlock Text="{Binding BannerMessage}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1F2937"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#B45309"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FilterVariant" VerticalAlignment="Center" Foreground="#1954D1" Margin="0,0,10,0" Width="22" Height="22"/>
                <TextBlock Text="Filter Pipeline:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4B5563" FontSize="14" Margin="0,0,20,0"/>

                <ComboBox SelectedValue="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" 
                          materialDesign:HintAssist.Hint="Month" Width="110" Margin="0,0,15,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Padding="10,0">
                    <system:Int32>1</system:Int32>
                    <system:Int32>2</system:Int32>
                    <system:Int32>3</system:Int32>
                    <system:Int32>4</system:Int32>
                    <system:Int32>5</system:Int32>
                    <system:Int32>6</system:Int32>
                    <system:Int32>7</system:Int32>
                    <system:Int32>8</system:Int32>
                    <system:Int32>9</system:Int32>
                    <system:Int32>10</system:Int32>
                    <system:Int32>11</system:Int32>
                    <system:Int32>12</system:Int32>
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" 
                          materialDesign:HintAssist.Hint="Year" Width="120" Margin="0,0,15,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Padding="10,0">
                    <system:Int32>2024</system:Int32>
                    <system:Int32>2025</system:Int32>
                    <system:Int32>2026</system:Int32>
                    <system:Int32>2027</system:Int32>
                </ComboBox>

                <ComboBox ItemsSource="{Binding Departments}" 
                          SelectedItem="{Binding SelectedDepartment}" 
                          DisplayMemberPath="DepartmentName"
                          materialDesign:HintAssist.Hint="Select Department" Width="250" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Padding="10,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding PendingPayrolls}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" Background="White" RowHeight="48" 
                  Style="{StaticResource MaterialDesignDataGrid}" AlternatingRowBackground="#FAFBFC"
                  BorderThickness="0" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="Auto" MinWidth="70">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Employee Name" Width="2*">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                                <Border Width="30" Height="30" Background="#E0E7FF" CornerRadius="15" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="Account" Foreground="#1954D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding EmployeeName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1A1C29"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Period" Width="0.8*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0:D2}/{1}">
                            <MultiBinding.Bindings>
                                <Binding Path="Month"/>
                                <Binding Path="Year"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Basic Salary" Binding="{Binding BasicSalary, StringFormat={}{0:N0} USD}" Width="1.2*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Bonuses" Binding="{Binding TotalBonus, StringFormat={}{0:N0} USD}" Width="1.2*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#059669"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Deductions" Binding="{Binding Deductions, StringFormat={}{0:N0} USD}" Width="1.2*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#E11D48"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Total Salary" Binding="{Binding TotalSalary, StringFormat={}{0:N0} USD}" Width="1.4*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#1954D1"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Popup IsOpen="{Binding IsRejectPopupOpen}" 
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
               Placement="Center" AllowsTransparency="True" StaysOpen="False">
            <Border Background="White" Width="400" CornerRadius="16" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#0f172a" Opacity="0.12" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🚫 Reject Feedback Required" FontSize="16" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8"/>

                    <TextBlock Margin="0,0,0,15" FontSize="13" Foreground="#6B7280">
                        <Run Text="Department: "/>
                        <Run Text="{Binding SelectedDepartment.DepartmentName, FallbackValue='N/A'}" FontWeight="Bold" Foreground="#1F2937"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding SelectedMonth, FallbackValue='0'}" FontWeight="Bold" Foreground="#1F2937"/>
                        <Run Text="/"/>
                        <Run Text="{Binding SelectedYear, FallbackValue='0'}" FontWeight="Bold" Foreground="#1F2937"/>
                        <Run Text=")"/>
                    </TextBlock>

                    <TextBlock Text="Provide rejection reason to HR Staff:" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#374151" FontSize="13"/>
                    <TextBox Text="{Binding RejectReasonInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="CANCEL" Command="{Binding CloseRejectPopupCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#4B5563" Height="38" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="SUBMIT REJECT" Command="{Binding ConfirmRejectPayrollCommand}" 
                                Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="38" Margin="6,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>