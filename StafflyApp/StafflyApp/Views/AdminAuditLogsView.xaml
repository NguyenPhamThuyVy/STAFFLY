<UserControl x:Class="StafflyApp.Views.AdminAuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:StafflyApp.ViewModels"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.DataContext>
        <vm:AdminAuditLogsViewModel/>
    </UserControl.DataContext>

    <Border Background="White" CornerRadius="25" Padding="30" Margin="10,0,10,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Security &amp; Audit Logs" FontSize="26" FontWeight="Bold" Foreground="#BE123C"/>
                    <TextBlock Text="Trace system footprints and monitor continuous runtime operations." Foreground="#6B7280" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Width="300" 
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search logs dynamically..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="10">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyFilterCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding LoadSystemLogsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Refresh Logs" Margin="10,0,0,0" Height="40" Width="40">
                        <materialDesign:PackIcon Kind="Refresh" Foreground="#BE123C" Height="24" Width="24"/>
                    </Button>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding LogsList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0" Background="White" RowHeight="42"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="170" Foreground="#6B7280"/>

                    <DataGridTextColumn Header="Operator ID" Binding="{Binding UserID, TargetNullValue='System'}" Width="110" FontWeight="SemiBold" Foreground="#1A1C29"/>

                    <DataGridTemplateColumn Header="Action Type" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Action}" FontWeight="Bold" FontSize="12"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Setter Property="TextBlock.Foreground" Value="#4B5563"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="LOGIN">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#15803D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="CREATE_USER">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#1D4ED8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="RESET_PASSWORD">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#B45309"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="REQUEST_RESET_PASS">
                                                    <Setter Property="Background" Value="#FFEDD5"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#C2410C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Log Description / Business Context" Binding="{Binding Detail}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>