<Window x:Class="StafflyApp.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:StafflyApp.ViewModels"
        Title="Security Credentials Update" Width="450" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9">

    <Window.DataContext>
        <vm:ChangePasswordViewModel/>
    </Window.DataContext>

    <Border Background="White" CornerRadius="20" Margin="20" Padding="30" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#000" Opacity="0.05"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="ShieldLock" Width="50" Height="50" Foreground="#1954D1" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Force Password Update" FontSize="22" FontWeight="Bold" Foreground="#1A1C29" HorizontalAlignment="Center"/>
            <TextBlock Text="You are currently using a default or reset password. Please construct a new key to proceed." 
                       Foreground="#6B7280" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,25"/>

            <PasswordBox x:Name="NewPasswordBox" materialDesign:HintAssist.Hint="New Secret Password" 
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

            <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Confirm Secret Password" 
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,25"/>

            <Button Content="UPDATE &amp; LAUNCH APP" Command="{Binding ConfirmChangePasswordCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="#1954D1" Foreground="White" FontWeight="Bold" Height="45" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="10"/>
        </StackPanel>
    </Border>
</Window>