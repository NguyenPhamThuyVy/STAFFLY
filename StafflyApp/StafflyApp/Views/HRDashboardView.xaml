<UserControl x:Class="StafflyApp.Views.HRDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="#F4F6F9" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ChartTimelineVariant" VerticalAlignment="Center" Foreground="#1954D1" Margin="0,0,8,0" Width="20" Height="20"/>
                <TextBlock Text="Dashboard Period:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4B5563" FontSize="13" Margin="0,0,15,0"/>

                <ComboBox SelectedValue="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" 
                          materialDesign:HintAssist.Hint="Month" Width="110" Margin="0,0,12,0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Padding="10,0">
                    <system:Int32>1</system:Int32>
                    <system:Int32>2</system:Int32>
                    <system:Int32>3</system:Int32>
                    <system:Int32>4</system:Int32>
                    <system:Int32>5</system:Int32>
                    <system:Int32>6</system:Int32>
                    <system:Int32>7</system:Int32>
                    <system:Int32>8</system:Int32>
                    <system:Int32>9</system:Int32>
                    <system:Int32>10</system:Int32>
                    <system:Int32>11</system:Int32>
                    <system:Int32>12</system:Int32>
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" 
                          materialDesign:HintAssist.Hint="Year" Width="110"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Padding="10,0">
                    <system:Int32>2024</system:Int32>
                    <system:Int32>2025</system:Int32>
                    <system:Int32>2026</system:Int32>
                    <system:Int32>2027</system:Int32>
                </ComboBox>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ACTIVE WORKFORCE" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalStaffCount}" FontSize="28" FontWeight="Bold" Foreground="#1954D1" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL MONTHLY PAYROLL BUDGET" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalPayrollBudget, StringFormat={}{0:N0} USD}" FontSize="28" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📊 Monthly Payroll Budget Distribution by Department" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding PayrollByDeptSeries}" LegendLocation="None">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding DepartmentLabels}" LabelsRotation="45">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" IsEnabled="False"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding CurrencyFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🍕 Headcount Allocation Share" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <lvc:PieChart Grid.Row="1" Series="{Binding StaffShareSeries}" LegendLocation="Right" MinHeight="350"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>