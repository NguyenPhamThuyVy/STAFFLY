<UserControl x:Class="StafflyApp.Views.AttendanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="20" Padding="30" Width="800" MaxHeight="700">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="DEPARTMENT ATTENDANCE IMPORT" FontSize="22" FontWeight="Bold" Foreground="#1A365D"/>
                <TextBlock Text="Upload aggregated Excel sheet containing total Absences and Tardiness for all departments." Foreground="#6B7280" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Target Month" Foreground="#6B7280" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding ImportMonth, UpdateSourceTrigger=PropertyChanged}" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" Padding="10,0">
                            <system:Int32>1</system:Int32>
                            <system:Int32>2</system:Int32>
                            <system:Int32>3</system:Int32>
                            <system:Int32>4</system:Int32>
                            <system:Int32>5</system:Int32>
                            <system:Int32>6</system:Int32>
                            <system:Int32>7</system:Int32>
                            <system:Int32>8</system:Int32>
                            <system:Int32>9</system:Int32>
                            <system:Int32>10</system:Int32>
                            <system:Int32>11</system:Int32>
                            <system:Int32>12</system:Int32>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Target Year" Foreground="#6B7280" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding ImportYear, UpdateSourceTrigger=PropertyChanged}" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" Padding="10,0">
                            <system:Int32>2024</system:Int32>
                            <system:Int32>2025</system:Int32>
                            <system:Int32>2026</system:Int32>
                            <system:Int32>2027</system:Int32>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding SelectExcelFileCommand}" 
                        Background="#10B981" Foreground="White" BorderThickness="0" 
                        Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="BROWSE FILE" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="8" Margin="15,0,0,0" Padding="15,0">
                    <TextBlock Text="{Binding ExcelFilePath, TargetNullValue='No file selected...'}" 
                               VerticalAlignment="Center" Foreground="#6B7280" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <DataGrid Grid.Row="3" ItemsSource="{Binding ImportedAttendanceRecords}" 
          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
          Style="{StaticResource MaterialDesignDataGrid}" MinHeight="250"
          BorderThickness="1" BorderBrush="#E2E8F0" Background="White"
          SelectionMode="Single" AlternatingRowBackground="#FAFBFC">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="Background" Value="#FFF1F2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="60"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Only valid department records will be processed." 
                           Foreground="#9CA3AF" FontStyle="Italic" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="CANCEL" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#6B7280" Margin="0,0,10,0"/>

                <Button Grid.Column="2" Content="CONFIRM &amp; SAVE" Command="{Binding SaveAttendanceCommand}" 
                        Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVis}}"
                        Background="#1954D1" Foreground="White" FontWeight="Bold" Padding="20,0" Height="40" materialDesign:ButtonAssist.CornerRadius="8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>